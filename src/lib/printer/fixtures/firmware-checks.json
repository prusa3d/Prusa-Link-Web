      "tools": [{ "material": "PLA" }, { "material": "PLA" }],
      "mapping": { "1": [1] },
      "checks": [
        { "check": "Nozzle not high-flow", "level": "warning", "tool": 1 }
      ]
    },
    {
      "name": "MMU: high-flow G-code on the standard head also fails the MMU check; no sensor check",
      "mmu": true,
      "header": {
        "filament used [g]": "5, 3",

      "tools": [{ "material": "PLA" }, {}],
      "mapping": { "1": [1], "2": [2] },
      "checks": [
        { "check": "Nozzle high-flow mismatch", "level": "warning", "tool": 1 },
        { "check": "Nozzle not high-flow", "level": "warning", "tool": 1 },
        { "check": "Nozzle high-flow mismatch", "level": "warning", "tool": 2 },
        { "check": "Nozzle not high-flow", "level": "warning", "tool": 2 },
        { "check": "Wrong filament type", "level": "warning", "tool": 2 }
      ]
    },
    {

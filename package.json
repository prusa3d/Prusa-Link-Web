{
  "name": "prusalink-web",
  "version": "2.1.0",
  "private": true,
  "license": "GPL-3.0",
  "description": "PrusaLink web interface served by the Buddy firmware: one self-contained index.html.",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "dev:printer": "PRINTER_URL=${PRINTER_URL:-http://127.0.0.1:8180} vite",
    "build": "node scripts/build-all.ts && node scripts/check-size.ts",
    "build:demo": "vite build --mode demo",
    "preview": "vite preview",
    "preview:demo": "vite preview --mode demo --host 127.0.0.1 --port 5959 --strictPort",
    "serve": "node scripts/serve.mjs",
    "storybook": "storybook dev -p 6006",
    "build-storybook": "storybook build -o storybook-static",
    "lint": "eslint . --concurrency=auto",
    "lint:fix": "eslint . --fix",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "check:svelte": "svelte-check --tsconfig ./tsconfig.json --fail-on-warnings",
    "test": "vitest run",
    "test:e2e": "playwright test",
    "test:e2e:demo": "playwright test -c playwright.demo.config.ts",
    "check": "pnpm run lint && pnpm run format:check && pnpm run check:svelte && pnpm run test",
    "prepare": "husky",
    "spec:sync": "node scripts/spec.ts sync && openapi-typescript spec/openapi.yaml -o src/lib/api/schema.d.ts",
    "spec:update": "node scripts/spec.ts update && openapi-typescript spec/openapi.yaml -o src/lib/api/schema.d.ts",
    "spec:check": "node scripts/spec.ts check",
    "predev": "pnpm spec:sync",
    "prebuild": "pnpm spec:sync",
    "pretest": "pnpm spec:sync",
    "precheck:svelte": "pnpm spec:sync",
    "icons": "node scripts/icons.ts && prettier --write src/lib/ui/icon/icons.ts"
  },
  "lint-staged": {
    "*": "prettier --write --ignore-unknown",
    "*.{ts,js,mjs,cjs,svelte}": "eslint --fix --no-warn-ignored"
  },
  "devDependencies": {
    "@lucide/svelte": "1.58.0",
    "@playwright/test": "1.64.1",
    "@prusa/frontend-standards": "github:prusa3d/prusa-connect#74a5dc0c7ff48396595c01c2445f3727fa64c730&path:packages/standards",
    "@resvg/resvg-js": "2.6.2",
    "@rive-app/canvas-lite": "2.54.0",
    "@storybook/addon-docs": "10.6.2",
    "@storybook/addon-svelte-csf": "5.1.5",
    "@storybook/svelte": "10.6.2",
    "@storybook/svelte-vite": "10.6.2",
    "@sveltejs/vite-plugin-svelte": "7.3.1",
    "@tailwindcss/vite": "4.3.3",
    "@types/node": "22.20.5",
    "@vitest/browser-playwright": "5.0.5",
    "eslint": "10.12.0",
    "fflate": "0.8.2",
    "husky": "9.1.7",
    "lint-staged": "17.6.0",
    "openapi-fetch": "0.17.0",
    "openapi-typescript": "7.13.0",
    "playwright": "1.64.1",
    "prettier": "3.9.10",
    "storybook": "10.6.2",
    "svelte": "5.57.2",
    "svelte-check": "4.7.6",
    "svgo": "4.0.0",
    "svgpath": "2.6.0",
    "tailwindcss": "4.3.3",
    "typescript": "6.0.3",
    "vite": "8.3.4",
    "vite-plugin-singlefile": "2.3.4",
    "vitest": "5.0.5",
    "vitest-browser-svelte": "3.1.0",
    "yaml": "2.9.1"
  },
  "packageManager": "pnpm@11.3.0",
  "engines": {
    "node": ">=22.12.0"
  }
}

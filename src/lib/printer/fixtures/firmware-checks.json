      "tools": [{ "material": "PLA" }, { "material": "PLA" }],
      "nozzleCheck": "ignore",
      "mapping": { "1": [1] },
      "checks": []
    },
    {
      "name": "abrasive filament, nozzle not hardened",
      "header": {
        "filament used [g]": "5",

        "nozzle_diameter": "0.6"
      },
      "tools": [{ "material": "PLA" }, { "material": "PLA" }],
      "nozzleCheck": "abort",
      "mapping": { "1": [1] },
      "checks": [
        { "check": "Wrong nozzle diameter", "level": "abort", "tool": 1 }
      ]
    },
    {
      "name": "nozzle checks off",
      "header": {
        "filament used [g]": "5",
        "filament_type": "PLA",

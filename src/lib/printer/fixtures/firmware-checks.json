{
  "source": "Buddy prusalink-api-v2, src/feature/compatibility_checks/gcode_compatibility.cpp: the checks GCodeToolCheck/VirtualToolCheck fail per G-code and printer tool, their CheckMetadata severity, and hw_checks. Each case is what the firmware's report lists for the input.",
  "cases": [
    {
      "name": "XL, all loaded as sliced",
      "header": {
        "filament used [g]": "5, 3",
        "filament_type": "PLA;PETG",
        "nozzle_diameter": "0.4,0.4"
      },
      "tools": [{ "material": "PLA" }, { "material": "PETG" }],
      "mapping": { "1": [1], "2": [2] },
      "checks": []
    },
    {
      "name": "wrong filament type is a fixed warning",
      "header": { "filament used [g]": "5, 3", "filament_type": "PLA;ASA" },
      "tools": [{ "material": "PLA" }, { "material": "PETG" }],
      "mapping": { "1": [1], "2": [2] },
      "checks": [
        { "check": "Wrong filament type", "level": "warning", "tool": 2 }
      ]
    },
    {
      "name": "names compare exactly: TPU is not FLEX",
      "header": { "filament used [g]": "5, 3", "filament_type": "PLA;TPU" },
      "tools": [{ "material": "PLA" }, { "material": "FLEX" }],
      "mapping": { "1": [1], "2": [2] },
      "checks": [
        { "check": "Wrong filament type", "level": "warning", "tool": 2 }
      ]
    },
    {
      "name": "no filament type in the file: no type check",
      "header": { "filament used [g]": "5, 3" },
      "tools": [{ "material": "PLA" }, { "material": "PETG" }],
      "mapping": { "1": [1], "2": [2] },
      "checks": []
    },
    {
      "name": "an empty tool: the sensor sees no filament, the type differs",
      "header": { "filament used [g]": "5, 3", "filament_type": "PLA;PLA" },
      "tools": [{ "material": "PLA" }, {}],
      "mapping": { "1": [1], "2": [2] },
      "checks": [
        { "check": "Filament not loaded", "level": "warning", "tool": 2 },
        { "check": "Wrong filament type", "level": "warning", "tool": 2 }
      ]
    },
    {
      "name": "a used G-code tool left unmapped aborts",
      "header": { "filament used [g]": "5, 3", "filament_type": "PLA;PLA" },
      "tools": [{ "material": "PLA" }, { "material": "PLA" }],
      "mapping": { "1": [1] },
      "checks": [
        { "check": "Unmapped tool", "level": "abort", "gcode_tool": 2 }
      ]
    },
    {
      "name": "a disabled tool is the wrong tool, a fixed abort",
      "header": { "filament used [g]": "5", "filament_type": "PLA" },
      "tools": [{ "material": "PLA" }, { "disabled": true }],
      "mapping": { "1": [2] },
      "checks": [{ "check": "Wrong tool", "level": "abort", "tool": 2 }]
    },
    {
      "name": "0.0002 g is not used; 0.02 g is",
      "header": {
        "filament used [g]": "5, 0.0002, 0.02",
        "filament_type": "PLA;PLA;PLA"
      },
      "tools": [
        { "material": "PLA" },
        { "material": "PLA" },
        { "material": "PLA" }
      ],
      "mapping": { "1": [1] },
      "checks": [
        { "check": "Unmapped tool", "level": "abort", "gcode_tool": 3 }
      ]
    },
    {
      "name": "nozzle diameter by hw_checks.nozzle",
      "header": {
        "filament used [g]": "5",

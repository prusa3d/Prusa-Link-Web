      "mapping": { "1": [1, 2] },
      "checks": [
        { "check": "Wrong nozzle diameter", "level": "abort", "tool": 2 }
      ]
    },
    {
      "name": "more used G-code tools than enabled tools",
      "header": {
        "filament used [g]": "5, 3, 2",
        "filament_type": "PLA;PLA;PLA"
      },
      "tools": [{ "material": "PLA" }, { "material": "PLA" }],
      "mapping": { "1": [1], "2": [2] },
      "checks": [
        { "check": "Not enough tools", "level": "warning" },
        { "check": "Unmapped tool", "level": "abort", "gcode_tool": 3 }
      ]
    },
    {
      "name": "sliced for another printer, by hw_checks.model",
      "header": {
        "filament used [g]": "5",
